# Copy this file to .env and replace the placeholder with your bot token.
DISCORD_TOKEN=replace-with-your-discord-bot-token
DEVELOPMENT_GUILD_ID=
BIGDPP_LLM_ENABLED=false
BIGDPP_LLM_AUTOSTART=true
BIGDPP_LLM_BASE_URL=http://127.0.0.1:11434
BIGDPP_LLM_MODEL=llama3.2
BIGDPP_AI_CHANNEL_NAME=ai-agent
BIGDPP_LLM_EXECUTABLE=ollama
